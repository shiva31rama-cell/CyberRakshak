{
  "version": "2.0",
  "description": "Shared content contract for multilingual CyberRakshak educational records.",
  "supportedLanguages": ["en", "te"],
  "defaultLanguage": "en",
  "localizableFields": ["title", "scenario", "redFlags", "safeAction", "checkQuestion", "answers"],
  "lesson": {
    "required": ["id", "category", "severity", "durationMinutes", "sourceIds", "en"],
    "properties": {
      "id": { "type": "string" },
      "category": { "type": "string" },
      "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
      "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
      "sourceIds": { "type": "array", "items": { "type": "string" } },
      "en": { "$ref": "#/$defs/languageContent" },
      "te": { "$ref": "#/$defs/languageContent" }
    }
  },
  "$defs": {
    "languageContent": {
      "type": "object",
      "required": ["title", "scenario", "redFlags", "safeAction", "checkQuestion", "answers"],
      "properties": {
        "title": { "type": "string" },
        "scenario": { "type": "string" },
        "redFlags": { "type": "array", "items": { "type": "string" } },
        "safeAction": { "type": "string" },
        "checkQuestion": { "type": "string" },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "correct"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "correct": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "rules": [
    "Every lesson must provide English content.",
    "Telugu content is optional at the record level and falls back to English when absent.",
    "Telugu content should preserve safety meaning rather than translate identifiers, source IDs, URLs or category IDs.",
    "Correct-answer flags are language-independent.",
    "Unknown requested languages fall back to English."
  ]
}
