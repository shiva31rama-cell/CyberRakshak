{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberRakshak Threat Intelligence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "severity",
    "status",
    "summary",
    "indicators",
    "actions",
    "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,119}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 240 },
    "category": { "type": "string", "minLength": 2, "maxLength": 80 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "status": { "enum": ["active", "monitoring", "resolved", "deprecated"] },
    "summary": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "indicators": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    },
    "publishedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "region": { "type": "string", "maxLength": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "sourceType", "verification"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 200 },
          "url": { "type": "string", "format": "uri" },
          "sourceType": {
            "enum": [
              "government",
              "regulator",
              "official_vendor",
              "academic",
              "security_research",
              "reputable_media",
              "official_social",
              "public_repository",
              "community"
            ]
          },
          "verification": {
            "enum": ["verified", "partially_verified", "unverified", "deprecated"]
          }
        }
      }
    }
  }
}
