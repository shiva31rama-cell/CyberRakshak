# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a long random secret for production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# OpenAI-compatible chat provider (keep these values only on the backend)
# Example URL: https://api.openai.com/v1/chat/completions
AI_API_KEY=replace-with-server-side-ai-key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=replace-with-a-chat-model
# Optional: override the safety/system prompt
# AI_SYSTEM_PROMPT=You are CyberRakshak, a concise cyber-safety education assistant.
