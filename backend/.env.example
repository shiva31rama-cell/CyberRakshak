# MongoDB Atlas (temporary until PostgreSQL migration)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a long random secret for production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# CyberRakshak AI routing
# auto = Gemini -> OpenRouter -> deterministic local fallback
AI_PROVIDER=auto
CHAT_MAX_MESSAGES=12
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_AI_TIMEOUT_MS=20000

# Primary free-tier provider: Google Gemini API
# Create your own key in Google AI Studio and keep it server-side only.
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional secondary free provider: OpenRouter free-model router
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Legacy generic AI settings are intentionally no longer used by the CyberRakshak chatbot.
