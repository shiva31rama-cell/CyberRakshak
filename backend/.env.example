# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a long random secret for production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional AI provider (OpenAI-compatible Chat Completions API)
# Leave unset to use CyberRakshak's local defensive safety fallback.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace-with-provider-key
AI_MODEL=replace-with-provider-model
# AI_SYSTEM_PROMPT=Optional custom defensive cyber-safety system prompt
