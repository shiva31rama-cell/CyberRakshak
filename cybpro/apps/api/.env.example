# Bind to LAN only for trusted-network mobile testing; do not expose publicly.
HOST=0.0.0.0
PORT=4000
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Optional live URL reputation lookup. Leave empty to keep analysis local-only.
# If configured, submitted URLs are shared with Google Safe Browsing for lookup.
GOOGLE_SAFE_BROWSING_API_KEY=
